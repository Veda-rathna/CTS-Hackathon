# Application
APP_NAME=Prior Authorization Triage API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prior_auth

# Repository mode — set to false when PostgreSQL is ready
USE_MOCK_REPOSITORIES=true

# API
API_V1_PREFIX=/api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# Logging
LOG_LEVEL=INFO
